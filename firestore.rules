/**
 * @file Firestore Security Rules for BeautifulSoup&Food
 *
 * Core Philosophy:
 * This ruleset prioritizes secure data access by strictly enforcing user ownership and admin roles where applicable. It assumes all writes must be explicitly authorized, and defaults to denying access unless a specific rule grants it.
 *
 * Data Structure:
 * Data is organized hierarchically with user-specific data nested under `/users/{userId}`. Publicly readable data (products, flyers, settings) resides in top-level collections. Chat messages are stored in `/chat_messages` with sender and receiver IDs for direct access control.
 *
 * Key Security Decisions:
 * - User data and related subcollections (orders, cart items, notifications, service checklist items) are accessible only to the owner and admins.
 * - Products, Flyers and Settings are publicly readable, but only modifiable by admins.
 * - Listing user documents is allowed only for admins.
 * - Chat messages can be created by any signed-in user. Read access is only possible via `get()` if the requesting user is either the sender or receiver. `list()` is disallowed.
 * - Existence of document in `/roles_admin/{userId}` grants admin role to the specified user.
 * - Relational integrity is enforced on create operations to ensure data consistency and prevent abuse.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own user profile. Admins can also read and write user profiles.
     * @path /users/{userId}
     * @allow (create) - User creates their own profile with matching UID.
     * @allow (get, update, delete) - User accesses their own profile. Admin accesses any profile.
     * @deny (create) - User attempts to create a profile with a mismatched UID.
     * @deny (get, update, delete) - User attempts to access another user's profile.
     * @principle Enforces document ownership and admin override.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin()) && resource != null;
    }

    /**
     * @description Allows anyone to read product information, but only admins can modify it.
     * @path /products/{productId}
     * @allow (get, list) - Any user can view product information.
     * @allow (create, update, delete) - Only admins can modify product information.
     * @deny (create, update, delete) - Non-admin users cannot modify product information.
     * @principle Enforces public read access with admin-only writes.
     */
    match /products/{productId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get, list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin() && resource != null;
      allow delete: if isSignedIn() && isAdmin() && resource != null;
    }

    /**
     * @description Allows users to read and write their own orders. Admins can also read and write orders.
     * @path /users/{userId}/orders/{orderId}
     * @allow (create) - User creates an order under their own user ID.
     * @allow (get, update, delete) - User accesses their own order. Admin accesses any order.
     * @deny (create) - User attempts to create an order under another user's ID.
     * @deny (get, update, delete) - User attempts to access another user's order.
     * @principle Enforces document ownership and admin override.
     */
    match /users/{userId}/orders/{orderId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && resource != null && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin()) && resource != null;
    }

    /**
     * @description Allows users to read and write their own cart items. Admins can also read and write cart items.
     * @path /users/{userId}/cart_items/{cartItemId}
     * @allow (create) - User creates a cart item under their own user ID.
     * @allow (get, update, delete) - User accesses their own cart item. Admin accesses any cart item.
     * @deny (create) - User attempts to create a cart item under another user's ID.
     * @deny (get, update, delete) - User attempts to access another user's cart item.
     * @principle Enforces document ownership and admin override.
     */
    match /users/{userId}/cart_items/{cartItemId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && resource != null && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin()) && resource != null;
    }

    /**
     * @description Allows any signed-in user to create chat messages. Read access requires either being the sender or the receiver. Listing is disallowed.
     * @path /chat_messages/{chatMessageId}
     * @allow (create) - Any signed-in user can create a chat message.
     * @allow (get) - User can read a chat message if they are the sender or receiver.
     * @deny (list) - Listing chat messages is disallowed.
     * @deny (update, delete) - Only creator can update or delete the message.
     * @principle Enforces sender/receiver-based access control.
     */
    match /chat_messages/{chatMessageId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to read flyer information, but only admins can modify it.
     * @path /flyers/{flyerId}
     * @allow (get, list) - Any user can view flyer information.
     * @allow (create, update, delete) - Only admins can modify flyer information.
     * @deny (create, update, delete) - Non-admin users cannot modify flyer information.
     * @principle Enforces public read access with admin-only writes.
     */
    match /flyers/{flyerId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get, list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin() && resource != null;
      allow delete: if isSignedIn() && isAdmin() && resource != null;
    }

    /**
     * @description Allows users to read and write their own service checklist items within their orders. Admins can also read and write service checklist items.
     * @path /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId}
     * @allow (create) - User creates a service checklist item under their own order.
     * @allow (get, update, delete) - User accesses their own service checklist item. Admin accesses any service checklist item.
     * @deny (create) - User attempts to create a service checklist item under another user's order.
     * @deny (get, update, delete) - User attempts to access another user's service checklist item.
     * @principle Enforces document ownership and admin override.
     */
    match /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.orderId == orderId;
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && resource != null && request.resource.data.orderId == resource.data.orderId;
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin()) && resource != null;
    }

     /**
      * @description Allows existence checks for admin role assignment.
      * @path /roles_admin/{userId}
      * @allow (get) - Anyone can check for admin status (but SHOULD NOT list).
      * @allow (create, update, delete) - Admins can manage other admins.
      * @deny (list) - Listing admin roles is not permitted.
      * @principle Uses document existence to grant admin privileges.
      */
    match /roles_admin/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin() && resource != null;
      allow delete: if isSignedIn() && isAdmin() && resource != null;
    }

    /**
     * @description Allows users to read and write their own notifications. Admins can also read and write notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (create) - User creates a notification under their own user ID.
     * @allow (get, update, delete) - User accesses their own notification. Admin accesses any notification.
     * @deny (create) - User attempts to create a notification under another user's ID.
     * @deny (get, update, delete) - User attempts to access another user's notification.
     * @principle Enforces document ownership and admin override.
     */
    match /users/{userId}/notifications/{notificationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && resource != null && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin()) && resource != null;
    }

    /**
     * @description Allows anyone to read the homepage settings, but only admins can modify them.
     * @path /settings/{settingId}
     * @allow (get, list) - Any user can view the homepage settings.
     * @allow (create, update, delete) - Only admins can modify the homepage settings.
     * @deny (create, update, delete) - Non-admin users cannot modify the homepage settings.
     * @principle Enforces public read access with admin-only writes.
     */
    match /settings/{settingId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get, list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin() && resource != null;
      allow delete: if isSignedIn() && isAdmin() && resource != null;
    }
  }
}