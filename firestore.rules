rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to manage their own profile. Admins can also manage user profiles.
     * @path /users/{userId}
     * @allow (create, update, get, delete, list) if isSignedIn() && isOwner(userId)
     * @allow (create, update, get, delete) if isSignedIn() && isAdmin()
     * @deny list if true
     * @principle Enforces document ownership and admin override for user profiles.
     */
    match /users/{userId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the user is the owner of the document
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if the user is an admin
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      // Helper function to check if the user is the existing owner of the document
      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data.userId == userId;
      }

      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    /**
     * @description Allows public read access to products. Admins can manage products.
     * @path /products/{productId}
     * @allow (get, list) if true
     * @allow (create, update, delete) if isSignedIn() && isAdmin()
     * @deny (create, update, delete) if !isSignedIn() || !isAdmin()
     * @principle Allows public read access with admin-only write access for products.
     */
    match /products/{productId} {
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the user is an admin
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      allow get, list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Allows users to manage their own orders. Admins can also manage orders.
     * @path /users/{userId}/orders/{orderId}
     * @allow (create, update, get, delete, list) if isSignedIn() && isOwner(userId)
     * @allow (create, update, get, delete) if isSignedIn() && isAdmin()
     * @deny (create, update, delete, list) if !isSignedIn()
     * @principle Enforces document ownership and admin override for orders.
     */
    match /users/{userId}/orders/{orderId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the user is the owner of the document
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if the user is an admin
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      // Helper function to check if the user is the existing owner of the document
      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data.userId == userId;
      }

      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    /**
     * @description Allows users to manage their own cart items. Admins can also manage cart items.
     * @path /users/{userId}/cart_items/{cartItemId}
     * @allow (create, update, get, delete, list) if isSignedIn() && isOwner(userId)
     * @allow (create, update, get, delete) if isSignedIn() && isAdmin()
     * @deny (create, update, delete, list) if !isSignedIn()
     * @principle Enforces document ownership and admin override for cart items.
     */
    match /users/{userId}/cart_items/{cartItemId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the user is the owner of the document
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if the user is an admin
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      // Helper function to check if the user is the existing owner of the document
      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data.userId == userId;
      }

      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    /**
     * @description Allows chat messages to be read and written by sender and receiver.
     * @path /chat_messages/{chatMessageId}
     * @allow (create, get, list) if isSignedIn() && (request.auth.uid == request.resource.data.senderId || request.auth.uid == request.resource.data.receiverId)
     * @allow (update, delete) if isSignedIn() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId)
     * @deny (create, update, delete, list) if !isSignedIn()
     * @principle Enforces access control based on sender and receiver IDs for chat messages.
     */
    match /chat_messages/{chatMessageId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == request.resource.data.senderId || request.auth.uid == request.resource.data.receiverId);
      allow update: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow delete: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }

    /**
     * @description Allows public read access to flyers. Admins can manage flyers.
     * @path /flyers/{flyerId}
     * @allow (get, list) if true
     * @allow (create, update, delete) if isSignedIn() && isAdmin()
     * @deny (create, update, delete) if !isSignedIn() || !isAdmin()
     * @principle Allows public read access with admin-only write access for flyers.
     */
    match /flyers/{flyerId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the user is an admin
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get, list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Allows users to manage their own service checklist items for their orders. Admins can also manage them.
     * @path /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId}
     * @allow (create, update, get, delete, list) if isSignedIn() && isOwner(userId)
     * @allow (create, update, get, delete) if isSignedIn() && isAdmin()
     * @deny (create, update, delete, list) if !isSignedIn()
     * @principle Enforces document ownership and admin override for service checklist items.
     */
    match /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the user is the owner of the document
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if the user is an admin
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      // Helper function to check if the user is the existing owner of the document
      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data.userId == userId;
      }

      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    /**
     * @description Allows admins to create, update, delete their role. Only admins have access
     * @path /roles_admin/{userId}
     * @allow (create, update, get, delete) if isSignedIn() && isAdmin()
     * @deny list if true
     */
    match /roles_admin/{userId} {
        // Helper function to check if the user is signed in
        function isSignedIn() {
            return request.auth != null;
        }

        // Helper function to check if the user is an admin
        function isAdmin() {
            return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
        }

        allow get: if isSignedIn() && isAdmin();
        allow list: if false;
        allow create: if isSignedIn() && isAdmin();
        allow update: if isSignedIn() && isAdmin();
        allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Allows users to manage their own notifications. Admins can also manage notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (create, update, get, delete, list) if isSignedIn() && isOwner(userId)
     * @allow (create, update, get, delete) if isSignedIn() && isAdmin()
     * @deny (create, update, delete, list) if !isSignedIn()
     * @principle Enforces document ownership and admin override for notifications.
     */
    match /users/{userId}/notifications/{notificationId} {
        // Helper function to check if the user is signed in
        function isSignedIn() {
            return request.auth != null;
        }

        // Helper function to check if the user is the owner of the document
        function isOwner(userId) {
            return request.auth.uid == userId;
        }

        // Helper function to check if the user is an admin
        function isAdmin() {
            return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
        }

        // Helper function to check if the user is the existing owner of the document
        function isExistingOwner(userId) {
            return isOwner(userId) && resource.data.userId == userId;
        }

        allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (isOwner(userId) || isAdmin());
        allow create: if isSignedIn() && isOwner(userId);
        allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
        allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    /**
     * @description Allows public read access to home page settings. Admins can manage settings.
     * @path /settings/{settingId}
     * @allow (get, list) if true
     * @allow (create, update, delete) if isSignedIn() && isAdmin()
     * @deny (create, update, delete) if !isSignedIn() || !isAdmin()
     * @principle Allows public read access with admin-only write access for general settings.
     */
    match /settings/{settingId} {
        // Helper function to check if the user is signed in
        function isSignedIn() {
            return request.auth != null;
        }

        // Helper function to check if the user is an admin
        function isAdmin() {
            return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
        }

        allow get, list: if true;
        allow create: if isSignedIn() && isAdmin();
        allow update: if isSignedIn() && isAdmin();
        allow delete: if isSignedIn() && isAdmin();
    }
  }
}