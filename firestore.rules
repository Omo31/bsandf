/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, with a focus on
 * isolating user data and restricting administrative privileges.
 *
 * Data Structure:
 * - User-specific data (orders, cart items, notifications) is stored under `/users/{userId}`.
 * - Products and Flyers are stored in top-level collections (`/products`, `/flyers`).
 * - Global settings are stored in the `/settings` collection.
 *
 * Key Security Decisions:
 * - Only authenticated users can access their own data under their respective `/users/{userId}` path.
 * - The `admin` role (checked via custom claim) is required for write access to products, flyers, and settings.
 * - Public read access is granted to the `/products` and `/flyers` collections.
 * - User listing is implicitly denied (no rule provided, therefore impossible).
 *
 * Denormalization for Authorization:
 * - User ID is used in subcollection paths to easily enforce user-ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     * @param {string} userId - The user ID to compare against.
     * @return {bool} True if the user is signed in and the UID matches, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an admin based on custom claim.
     * @return {bool} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    /**
     * @description Checks if the user is the owner of existing data.
     * @param {string} userId - The user ID to compare against.
     * @return {bool} True if the user is the owner, and the document exists.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) - User with matching UID can create their profile.
     * @allow (get, update, delete) - User can access/modify their own profile.
     * @deny (create) - User trying to create a profile with a different UID.
     * @deny (get, update, delete) - User trying to access/modify another user's profile.
     * @principle Enforces user-ownership for profile data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for product information.
     * @path /products/{productId}
     * @allow (get, list) - Public read access.
     * @allow (create, update, delete) - Only admins can modify product information.
     * @deny (create, update, delete) - Non-admins cannot modify product information.
     * @principle Restricts write access to admins.
     */
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for user orders.
     * @path /users/{userId}/orders/{orderId}
     * @allow (create, get, list) - User can create, read, and list their own orders.
     * @allow (update, delete) - User can update and delete their own orders.
     * @deny (create, get, list, update, delete) - User trying to access another user's orders.
     * @principle Enforces user-ownership for order data.
     */
    match /users/{userId}/orders/{orderId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for cart items.
     * @path /users/{userId}/cart_items/{cartItemId}
     * @allow (create, get, list) - User can create, read, and list their own cart items.
     * @allow (update, delete) - User can update and delete their own cart items.
     * @deny (create, get, list, update, delete) - User trying to access another user's cart items.
     * @principle Enforces user-ownership for cart data.
     */
    match /users/{userId}/cart_items/{cartItemId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for flyer information.
     * @path /flyers/{flyerId}
     * @allow (get, list) - Public read access.
     * @allow (create, update, delete) - Only admins can modify flyer information.
     * @deny (create, update, delete) - Non-admins cannot modify flyer information.
     * @principle Restricts write access to admins.
     */
    match /flyers/{flyerId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for service checklist items.
     * @path /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId}
     * @allow (create, get, list) - User can create, read, and list their own service checklist items.
     * @allow (update, delete) - User can update and delete their own service checklist items.
     * @deny (create, get, list, update, delete) - User trying to access another user's service checklist items.
     * @principle Enforces user-ownership for service checklist data.
     */
    match /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (create, get, list) - User can create, read, and list their own notifications.
     * @allow (update, delete) - User can update and delete their own notifications.
     * @deny (create, get, list, update, delete) - User trying to access another user's notifications.
     * @principle Enforces user-ownership for notification data.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for global settings.
     * @path /settings/{settingId}
     * @allow (get) - Public read access.
     * @allow (create, update, delete) - Only admins can modify settings.
     * @deny (create, update, delete) - Non-admins cannot modify settings.
     * @principle Restricts write access to admins.
     */
    match /settings/{settingId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }
  }
}