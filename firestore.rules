rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (create) User with matching auth ID can create their profile.
     * @allow (get, update, delete) User with matching auth ID can access their profile.
     * @deny (create, get, update, delete) Any other user cannot access this profile.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      // Allow the user to create their own profile if the user ID matches their auth UID.
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Allow the user to read, update, and delete their own profile.
      allow get, update, delete: if isOwner(userId);

      allow list: if false; // Listing users is not allowed.
    }

    /**
     * @description Controls access to product information.
     * @path /products/{productId}
     * @allow (get, list) All users can read product information.
     * @allow (create, update, delete) Only admins can modify product information.
     * @deny (create, update, delete) Non-admins cannot modify product information.
     * @principle Restricts write access to admins for product data.
     */
    match /products/{productId} {
      allow get, list: if true;

      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Controls access to user orders.
     * @path /users/{userId}/orders/{orderId}
     * @allow (create, get, update, delete, list) User with matching auth ID can access their orders.
     * @deny (create, get, update, delete, list) Any other user cannot access this order.
     * @principle Enforces document ownership for user orders.
     */
    match /users/{userId}/orders/{orderId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      // Allow the user to create their own orders if the user ID matches their auth UID.
      allow create: if request.auth.uid == userId;
      // Allow the user to read, update, and delete their own orders.
      allow get, update, delete: if isOwner(userId);

      allow list: if isOwner(userId);
    }

    /**
     * @description Controls access to cart items.
     * @path /users/{userId}/cart_items/{cartItemId}
     * @allow (create, get, update, delete, list) User with matching auth ID can access their cart items.
     * @deny (create, get, update, delete, list) Any other user cannot access this cart item.
     * @principle Enforces document ownership for cart items.
     */
    match /users/{userId}/cart_items/{cartItemId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      // Allow the user to create their own cart items if the user ID matches their auth UID.
      allow create: if request.auth.uid == userId;
      // Allow the user to read, update, and delete their own cart items.
      allow get, update, delete: if isOwner(userId);

      allow list: if isOwner(userId);
    }

    /**
     * @description Controls access to chat messages.
     * @path /chat_messages/{chatMessageId}
     * @allow (create) Any signed-in user can create chat messages.
     * @allow (get, list) Only the sender or receiver can access the chat message.
     * @deny (update, delete) No one can update or delete a chat message.
     * @principle Enforces access control based on sender and receiver IDs.
     */
    match /chat_messages/{chatMessageId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow create: if isSignedIn();
      allow get, list: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);

      allow update, delete: if false;
    }

    /**
     * @description Controls access to flyer information.
     * @path /flyers/{flyerId}
     * @allow (get, list) All users can read flyer information.
     * @allow (create, update, delete) Only admins can modify flyer information.
     * @deny (create, update, delete) Non-admins cannot modify flyer information.
     * @principle Restricts write access to admins for flyer data.
     */
    match /flyers/{flyerId} {
      allow get, list: if true;

      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Controls access to service checklist items.
     * @path /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId}
     * @allow (create, get, update, delete, list) User with matching auth ID can access service checklist items associated with their orders.
     * @deny (create, get, update, delete, list) Any other user cannot access these service checklist items.
     * @principle Enforces document ownership for service checklist items.
     */
    match /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      // Allow the user to create service checklist items for their own orders if the user ID matches their auth UID.
      allow create: if request.auth.uid == userId;
      // Allow the user to read, update, and delete service checklist items for their own orders.
      allow get, update, delete: if isOwner(userId);

      allow list: if isOwner(userId);
    }

    /**
     * @description Controls access to admin role assignments.
     * @path /roles_admin/{userId}
     * @allow (create) Only admins can assign admin roles.
     * @allow (get) Any authenticated user can check for admin roles.
     * @allow (update, delete) Only admins can modify admin role assignments.
     * @deny (create, update, delete) Non-admins cannot modify admin role assignments.
     * @principle Restricts write access to admins for role management.
     */
    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow create, update, delete: if isAdmin();
      allow list: if false; // Do not allow listing of admin roles.
    }

    /**
     * @description Checks if the user is an admin.
     * @return {bool} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
        return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Controls access to user notifications.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (create, get, update, delete, list) User with matching auth ID can access their notifications.
     * @deny (create, get, update, delete, list) Any other user cannot access this notification.
     */
    match /users/{userId}/notifications/{notificationId} {
       function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      // Allow the user to create their own notification items if the user ID matches their auth UID.
      allow create: if request.auth.uid == userId;
      // Allow the user to read, update, and delete their own notifications.
      allow get, update, delete: if isOwner(userId);

      allow list: if isOwner(userId);
    }

    /**
     * @description Controls access to global application settings.
     * @path /settings/{settingId}
     * @allow (get, list) All users can read the settings.
     * @allow (create, update, delete) Only admins can modify the settings.
     * @deny (create, update, delete) Non-admins cannot modify the settings.
     */
    match /settings/{settingId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}