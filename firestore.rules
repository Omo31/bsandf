/**
 * @file Firestore Security Rules for BeautifulSoup&Food
 *
 * @Core Philosophy: This ruleset enforces a strict user-ownership model for personal data,
 * allows public read access to product and flyer information, and restricts administrative
 * functions to authorized users.
 *
 * @Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only by the user and admins.
 * - /products/{productId}: Stores product information, publicly readable, writable only by admins.
 * - /users/{userId}/orders/{orderId}: Stores orders placed by users, accessible only by the user and admins.
 * - /users/{userId}/cart_items/{cartItemId}: Stores cart items for each user, accessible only by the user and admins.
 * - /chat_messages/{chatMessageId}: Stores chat messages between users and admins, accessible based on senderId and receiverId.
 * - /flyers/{flyerId}: Stores flyer information, publicly readable, writable only by admins.
 * - /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId}: Stores service checklist items for orders, accessible by the user and admins.
 * - /roles_admin/{userId}: Indicates admin privileges. Document existence grants admin role to the user.
 * - /users/{userId}/notifications/{notificationId}: Stores notifications for individual users, accessible only by the user.
 * - /settings/{settingId}: Stores global application settings, publicly readable, writable only by admins.
 *
 * @Key Security Decisions:
 * - User data is strictly controlled via path-based authorization.
 * - Public read access is granted to products, flyers, and general settings.
 * - Administrative privileges are determined by the existence of a document in the `/roles_admin/{userId}` collection.
 * - The rules explicitly deny any unauthorized access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures user profiles, accessible by the user and admins.
     * @path /users/{userId}
     * @allow (create) User with matching userId can create their profile.
     * @allow (get, update, delete) User with matching userId can read, update, or delete their profile. Admins can also read, update, or delete any user profile.
     * @deny (create) User attempts to create a profile with a mismatched userId.
     * @deny (get, update, delete) User attempts to access another user's profile without admin rights.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data != null;
      }

      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if false; // Do not allow listing of all users
      allow create: if isSignedIn() && isOwner(userId) && request.auth.uid == userId;
      allow update: if isSignedIn() && (isExistingOwner(userId) || isAdmin());
      allow delete: if isSignedIn() && (isExistingOwner(userId) || isAdmin());
    }

    /**
     * @description Secures product information, accessible for reading by all users, but writable only by admins.
     * @path /products/{productId}
     * @allow (get, list) Any user can read the product information.
     * @allow (create, update, delete) Only admins can create, update, or delete product information.
     * @deny (create, update, delete) Non-admins cannot create, update, or delete product information.
     * @principle Public read access with owner-only writes.
     */
    match /products/{productId} {
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get, list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Secures orders placed by users. Accessible by the user and admins.
     * @path /users/{userId}/orders/{orderId}
     * @allow (create) User with matching userId can create orders.
     * @allow (get, update, delete) User with matching userId can read, update, or delete their orders. Admins can also read, update, or delete any order.
     * @deny (create) User attempts to create an order with a mismatched userId.
     * @deny (get, update, delete) User attempts to access another user's order without admin rights.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/orders/{orderId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data != null;
      }

      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.auth.uid == userId;
      allow update: if isSignedIn() && (isExistingOwner(userId) || isAdmin());
      allow delete: if isSignedIn() && (isExistingOwner(userId) || isAdmin());
    }

    /**
     * @description Secures cart items for each user. Accessible only by the user and admins.
     * @path /users/{userId}/cart_items/{cartItemId}
     * @allow (create) User with matching userId can create cart items.
     * @allow (get, update, delete) User with matching userId can read, update, or delete their cart items. Admins can also read, update, or delete any cart item.
     * @deny (create) User attempts to create a cart item with a mismatched userId.
     * @deny (get, update, delete) User attempts to access another user's cart item without admin rights.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/cart_items/{cartItemId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data != null;
      }

      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.auth.uid == userId;
      allow update: if isSignedIn() && (isExistingOwner(userId) || isAdmin());
      allow delete: if isSignedIn() && (isExistingOwner(userId) || isAdmin());
    }

    /**
     * @description Secures chat messages between users and admins. Each document contains senderId and receiverId for direct access control.
     * @path /chat_messages/{chatMessageId}
     * @allow (create) Any signed-in user can create a chat message.
     * @allow (get) Any signed-in user can get a chat message if they are the sender or receiver.
     * @allow (list) Any signed-in user can list chat messages.
     * @deny (update, delete) Only the sender or an admin can update or delete a chat message.
     * @principle Shared Access (Closed Collaborators)
     */
    match /chat_messages/{chatMessageId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get: if isSignedIn() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false; // Updates are never allowed
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.senderId || isAdmin());
    }

    /**
     * @description Secures flyer information, accessible for reading by all users, but writable only by admins.
     * @path /flyers/{flyerId}
     * @allow (get, list) Any user can read the flyer information.
     * @allow (create, update, delete) Only admins can create, update, or delete flyer information.
     * @deny (create, update, delete) Non-admins cannot create, update, or delete flyer information.
     * @principle Public read access with owner-only writes.
     */
    match /flyers/{flyerId} {
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get, list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Secures service checklist items for custom orders. Accessible by the user and admins.
     * @path /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId}
     * @allow (create) User with matching userId can create service checklist items.
     * @allow (get, update, delete) User with matching userId can read, update, or delete their service checklist items. Admins can also read, update, or delete any service checklist item.
     * @deny (create) User attempts to create a service checklist item with a mismatched userId.
     * @deny (get, update, delete) User attempts to access another user's service checklist item without admin rights.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data != null;
      }

      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.auth.uid == userId;
      allow update: if isSignedIn() && (isExistingOwner(userId) || isAdmin());
      allow delete: if isSignedIn() && (isExistingOwner(userId) || isAdmin());
    }

    /**
     * @description Stores admin role assignments. Existence of a document grants admin privileges.
     * @path /roles_admin/{userId}
     * @allow (create) Only a user can create their own admin role assignment
     * @allow (get) Only the user that matches the userId can read the role assignment
     * @allow (delete) Only the user that matches the userId can delete the role assignment.
     * @deny (create) User attempts to create a role assignment with a mismatched userId.
     *  @deny (update) Updates are never allowed.
     * @principle Roles
     */
    match /roles_admin/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // Do not allow listing of all admins
      allow create: if isSignedIn() && isOwner(userId) && request.auth.uid == userId;
      allow update: if false; // Updates are never allowed
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Stores notifications for individual users.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (create) User with matching userId can create notifications.
     * @allow (get, update, delete) User with matching userId can read, update, or delete their notifications.
     * @deny (create) User attempts to create a notification with a mismatched userId.
     * @deny (get, update, delete) User attempts to access another user's notification.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/notifications/{notificationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.auth.uid == userId;
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Stores global application settings. Writable only by admins.
     * @path /settings/{settingId}
     * @allow (get, list) Any user can read the application settings.
     * @allow (create, update, delete) Only admins can create, update, or delete application settings.
     * @deny (create, update, delete) Non-admins cannot create, update, or delete application settings.
     * @principle Public read access with owner-only writes.
     */
    match /settings/{settingId} {
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get, list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }
  }
}