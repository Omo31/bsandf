/**
 * @fileoverview Firestore Security Rules for BeautifulSoup&Food.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user-specific data
 * (e.g., profiles, orders, cart items, notifications). Globally readable
 * data (e.g., products, flyers, home page settings) is also supported,
 * but write access to these collections is restricted.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles and serves as the root for
 *   user-specific data.
 * - /products/{productId}: Stores product information, publicly readable.
 * - /flyers/{flyerId}: Stores flyer/advertisement information, publicly
 *   readable.
 * - /settings/{settingId}: Stores global settings, such as home page
 *   configuration.
 *
 * Key Security Decisions:
 * - Users can only access their own data under /users/{userId}.
 * - Products and flyers are publicly readable but only writable by authorized users.
 * - Global settings can only be modified by authorized users.
 *
 * Denormalization for Authorization:
 *  The schema for entities such as Order includes the userId, so the rules can check
 *  the userId against the request.auth.uid to verify ownership.
 *
 *  Also for entities under a user collection like Notifications, the notification document
 *  includes the userId, so the rules can enforce consistency between the path
 *  (/users/{userId}/notifications/{notificationId}) and the document's internal fields.
 *
 * Structural Segregation:
 *  Publicly readable data (products, flyers) is stored in top-level collections,
 *  separate from private user data under /users/{userId}.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data.
     * @path /users/{userId}
     * @allow (read, write): if isSignedIn() && isOwner(userId);
     * @deny (read, write): if !isSignedIn() || !isOwner(userId);
     * @principle Enforces user-ownership for profile data.
     */
    match /users/{userId} {
      // Helper function to check if the request comes from the owner of the user ID.
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if a user is signed in.
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // Disable listing of all user profiles.
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to product information.
     * @path /products/{productId}
     * @allow (read): if true;
     * @allow (write): if false; // TODO: Add owner role check for writes.
     * @deny (write): if true;
     * @principle Allows public read access to product data.
     */
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner role check for writes.
    }

    /**
     * @description Controls access to orders placed by users.
     * @path /users/{userId}/orders/{orderId}
     * @allow (read, write): if isSignedIn() && isOwner(userId);
     * @deny (read, write): if !isSignedIn() || !isOwner(userId);
     * @principle Enforces user-ownership for order data.
     */
    match /users/{userId}/orders/{orderId} {
      // Helper function to check if the request comes from the owner of the user ID.
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if a user is signed in.
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to cart items for each user.
     * @path /users/{userId}/cart_items/{cartItemId}
     * @allow (read, write): if isSignedIn() && isOwner(userId);
     * @deny (read, write): if !isSignedIn() || !isOwner(userId);
     * @principle Enforces user-ownership for cart item data.
     */
    match /users/{userId}/cart_items/{cartItemId} {
      // Helper function to check if the request comes from the owner of the user ID.
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if a user is signed in.
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to flyer information.
     * @path /flyers/{flyerId}
     * @allow (read): if true;
     * @allow (write): if false; // TODO: Add owner role check for writes.
     * @deny (write): if true;
     * @principle Allows public read access to flyer data.
     */
    match /flyers/{flyerId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner role check for writes.
    }

    /**
     * @description Controls access to service checklist items for custom orders.
     * @path /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId}
     * @allow (read, write): if isSignedIn() && isOwner(userId);
     * @deny (read, write): if !isSignedIn() || !isOwner(userId);
     * @principle Enforces user-ownership for service checklist item data.
     */
    match /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId} {
      // Helper function to check if the request comes from the owner of the user ID.
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if a user is signed in.
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to notifications for individual users.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (read, write): if isSignedIn() && isOwner(userId);
     * @deny (read, write): if !isSignedIn() || !isOwner(userId);
     * @principle Enforces user-ownership for notification data.
     */
    match /users/{userId}/notifications/{notificationId} {
      // Helper function to check if the request comes from the owner of the user ID.
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if a user is signed in.
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to global application settings.
     * @path /settings/{settingId}
     * @allow (read): if true;
     * @allow (write): if false; // TODO: Add owner role check for writes.
     * @deny (write): if true;
     * @principle Restricts write access to global settings.
     */
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner role check for writes.
    }
  }
}