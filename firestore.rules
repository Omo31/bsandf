/**
 * @file Firestore Security Rules for BeautifulSoup&Food
 * @version Prototyping
 *
 * @Core Philosophy: This ruleset enforces a strict user-ownership model for personal data and admin-only access for sensitive configurations. Public read access is granted to product and flyer information.
 * @Data Structure: Data is organized hierarchically, with user-specific data nested under `/users/{userId}`.  Global data like products and flyers reside in top-level collections.
 * @Key Security Decisions:
 *  - User listing is not allowed.
 *  - Admin privileges are determined by the existence of a document in the `/roles_admin/{userId}` collection.
 *  - The `HomePageSettings` collection is readable by all but writable only by admins.
 *  - Data type and schema validation are relaxed to facilitate rapid prototyping.
 * @Denormalization for Authorization:
 *  - Chat messages include both `senderId` and `receiverId` to enable direct access control without additional `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profiles, allowing only the user and admins to read/write.
     * @path /users/{userId}
     * @allow (read, update, delete) if isOwner(userId) || isAdmin()
     * @allow (create) if isSelfCreate(userId)
     * @deny (read, update, delete) if !isOwner(userId) && !isAdmin()
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isSelfCreate(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    /**
     * @description Protects product information, allowing public read access and admin-only writes.
     * @path /products/{productId}
     * @allow (read) if true
     * @allow (create, update, delete) if isAdmin()
     * @deny (create, update, delete) if !isAdmin()
     * @principle Grants public read access with restricted write access.
     */
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Protects orders placed by users, accessible by the user and admins.
     * @path /users/{userId}/orders/{orderId}
     * @allow (read, update, delete) if isOwner(userId) || isAdmin()
     * @allow (create) if isOwner(userId)
     * @deny (read, update, delete) if !isOwner(userId) && !isAdmin()
     * @principle Enforces document ownership for writes within a user subcollection.
     */
    match /users/{userId}/orders/{orderId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    /**
     * @description Protects cart items for each user, accessible only by the user and admins.
     * @path /users/{userId}/cart_items/{cartItemId}
     * @allow (read, update, delete) if isOwner(userId) || isAdmin()
     * @allow (create) if isOwner(userId)
     * @deny (read, update, delete) if !isOwner(userId) && !isAdmin()
     * @principle Enforces document ownership for writes within a user subcollection.
     */
    match /users/{userId}/cart_items/{cartItemId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    /**
     * @description Protects chat messages between users and admins, using senderId and receiverId for access control.
     * @path /chat_messages/{chatMessageId}
     * @allow (read) if isSenderOrReceiver(request.auth.uid, resource.data.senderId, resource.data.receiverId) || isAdmin()
     * @allow (create) if isSignedIn()
     * @deny (update, delete) if true
     * @principle Uses sender and receiver IDs to control access to chat messages.
     */
    match /chat_messages/{chatMessageId} {
      allow get: if (getSenderId(resource.data) != null && getReceiverId(resource.data) != null && isSenderOrReceiver(request.auth.uid, getSenderId(resource.data), getReceiverId(resource.data))) || isAdmin();
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Protects flyer information, allowing public read access and admin-only writes.
     * @path /flyers/{flyerId}
     * @allow (read) if true
     * @allow (create, update, delete) if isAdmin()
     * @deny (create, update, delete) if !isAdmin()
     * @principle Grants public read access with restricted write access.
     */
    match /flyers/{flyerId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Protects service checklist items for custom orders, accessible by the user and admins.
     * @path /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId}
     * @allow (read, update, delete) if isOwner(userId) || isAdmin()
     * @allow (create) if isOwner(userId)
     * @deny (read, update, delete) if !isOwner(userId) && !isAdmin()
     * @principle Enforces document ownership for writes within a deeply nested user subcollection.
     */
    match /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    /**
     * @description Grants admin privileges based on the existence of a document in this collection.
     * @path /roles_admin/{userId}
     * @allow (read, create, update, delete) if isAdmin()
     * @deny (read, create, update, delete) if !isAdmin()
     * @principle Uses document existence to grant admin privileges.
     */
    match /roles_admin/{userId} {
        allow get: if isAdmin();
        allow list: if false;
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
    }

     /**
     * @description Protects notifications for individual users, accessible only by the user and admins.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (read, update, delete) if isOwner(userId) || isAdmin()
     * @allow (create) if isOwner(userId)
     * @deny (read, update, delete) if !isOwner(userId) && !isAdmin()
     * @principle Enforces document ownership for writes within a user subcollection.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }
     /**
     * @description Protects global application settings, allowing public read access and admin-only writes.
     * @path /settings/{settingId}
     * @allow (read) if true
     * @allow (create, update, delete) if isAdmin()
     * @deny (create, update, delete) if !isAdmin()
     * @principle Grants public read access with restricted write access.
     */
    match /settings/{settingId} {
        allow get, list: if true;
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return request.auth.uid == userId && resource.data != null;
  }

  function isSelfCreate(userId) {
      return request.auth.uid == userId;
  }

  function isAdmin() {
    return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
  }

  function isSenderOrReceiver(userId, senderId, receiverId) {
    return userId == senderId || userId == receiverId;
  }

  function getSenderId(data) {
    return data.senderId;
  }

    function getReceiverId(data) {
    return data.receiverId;
  }
}