/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for personal data,
 *              while allowing public read access to product and flyer information.
 *              Administrative privileges are granted based on the existence of a document in the `/roles_admin/{userId}` collection.
 *
 * @dataStructure
 *  - /users/{userId}: Stores user profiles, accessible only by the user and admins.
 *  - /products/{productId}: Stores product information, publicly readable, writable only by admins.
 *  - /users/{userId}/orders/{orderId}: Stores orders placed by users, accessible only by the user and admins.
 *  - /users/{userId}/cart_items/{cartItemId}: Stores cart items, accessible only by the user and admins.
 *  - /chat_messages/{chatMessageId}: Stores chat messages, accessible to sender and receiver
 *  - /flyers/{flyerId}: Stores flyer information, publicly readable, writable only by admins.
 *  - /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId}: Stores checklist items for orders, accessible by the user and admins.
 *  - /roles_admin/{userId}: Indicates admin privileges; existence grants admin role.
 *  - /users/{userId}/notifications/{notificationId}: Stores user notifications, accessible only by the user and admins.
 *  - /settings/{settingId}: Stores global settings, publicly readable, writable only by admins.
 *
 * @keySecurityDecisions
 *  - User listing is disallowed.
 *  - Public read access is granted to products and flyers.
 *  - Admin privileges are determined by the existence of a document in `/roles_admin/{userId}`.
 *  - Data validation is minimal to facilitate rapid prototyping; only authorization-critical fields are validated.
 *
 * @denormalizationForAuthorization
 *  - Admin status is checked by verifying the existence of a document in the `/roles_admin/{userId}` collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the requesting user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the requesting user's ID matches the provided userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

     /**
      * @description Checks if a user is an existing owner.
      *              Combines the ownership check with an existence check.
      */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the requesting user is an admin.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) - Authenticated user can create their own profile.
     * @allow (get, update, delete) - Authenticated user can access and modify their own profile. Admin can get, update, delete any profile
     * @deny (list) - User listing is not allowed.
     * @deny (create) - Authenticated user cannot create a profile with a different ID.
     * @principle Enforces document ownership for writes and restricts access to a user's own data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for product information.
     * @path /products/{productId}
     * @allow (get, list) - All users can read product information.
     * @allow (create, update, delete) - Only admins can create, update, or delete product information.
     * @deny (create, update, delete) - Non-admins cannot create, update, or delete product information.
     * @principle Allows public read access with owner-only (admin) writes.
     */
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for orders placed by users.
     * @path /users/{userId}/orders/{orderId}
     * @allow (get, list, create) - Authenticated user can read their own orders and create new orders.
     * @allow (update, delete) - Authenticated user can update or delete their own existing orders.
     * @deny (get, list, create, update, delete) - Authenticated user cannot access or modify orders of other users.
     *  Admin can get, update, delete any order.
     * @principle Enforces document ownership for writes and restricts access to a user's own data.
     */
    match /users/{userId}/orders/{orderId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for cart items.
     * @path /users/{userId}/cart_items/{cartItemId}
     * @allow (get, list, create) - Authenticated user can read and create their own cart items.
     * @allow (update, delete) - Authenticated user can update or delete their own cart items.
     * @deny (get, list, create, update, delete) - Authenticated user cannot access or modify cart items of other users.
     * Admin can get, update, delete any cart_item
     * @principle Enforces document ownership for writes and restricts access to a user's own data.
     */
    match /users/{userId}/cart_items/{cartItemId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for chat messages between users and admins.
     * @path /chat_messages/{chatMessageId}
     * @allow (get) - Sender and receiver can get the chat message.
     * @allow (list) - Sender and receiver can list the chat message.
     * @allow (create) - Any signed-in user can create a chat message.
     * @allow (update, delete) - Only the sender or admin can update or delete the chat message.
     * @principle Allows read access to participants and write access to the sender and admin.
     */
    match /chat_messages/{chatMessageId} {
      allow get: if isSignedIn() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId) || isAdmin();
      allow list: if isSignedIn() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId) || isAdmin();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == resource.data.senderId) || isAdmin();
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.senderId) || isAdmin();
    }

    /**
     * @description Rules for flyer information.
     * @path /flyers/{flyerId}
     * @allow (get, list) - All users can read flyer information.
     * @allow (create, update, delete) - Only admins can create, update, or delete flyer information.
     * @deny (create, update, delete) - Non-admins cannot create, update, or delete flyer information.
     * @principle Allows public read access with owner-only (admin) writes.
     */
    match /flyers/{flyerId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for service checklist items for custom orders.
     * @path /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId}
     * @allow (get, list, create) - Authenticated user can read and create their own service checklist items.
     * @allow (update, delete) - Authenticated user can update or delete their own service checklist items.
     * @deny (get, list, create, update, delete) - Authenticated user cannot access or modify service checklist items of other users.
     * Admin can get, update, delete any service_checklist_item
     * @principle Enforces document ownership for writes and restricts access to a user's own data.
     */
    match /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for admin role assignments.
     * @path /roles_admin/{userId}
     * @allow get: if false;
     * @allow list: if false;
     * @allow create: if isAdmin();
     * @allow update: if false;
     * @allow delete: if isAdmin();
     * @principle Existence of a document grants admin privileges.
     */
     match /roles_admin/{userId} {
        allow get: if false;
        allow list: if false;
        allow create: if isAdmin();
        allow update: if false;
        allow delete: if isAdmin();
    }

    /**
     * @description Rules for notifications for individual users.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (get, list, create) - Authenticated user can read and create their own notifications.
     * @allow (update, delete) - Authenticated user can update or delete their own notifications.
     * @deny (get, list, create, update, delete) - Authenticated user cannot access or modify notifications of other users.
     * Admin can get, update, delete any notification
     * @principle Enforces document ownership for writes and restricts access to a user's own data.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for global application settings.
     * @path /settings/{settingId}
     * @allow (get, list) - All users can read application settings.
     * @allow (create, update, delete) - Only admins can create, update, or delete settings.
     * @deny (create, update, delete) - Non-admins cannot create, update, or delete settings.
     * @principle Allows public read access with owner-only (admin) writes.
     */
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}