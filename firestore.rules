rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles. Users can only read/write their own profile.
     * @path /users/{userId}
     * @allow (create, update, get, delete) if the user's UID matches the userId.
     * @deny (create, update, get, delete) if the user's UID does not match the userId.
     * @principle Enforces document ownership for writes and reads.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    /**
     * @description Controls access to product information. Products are publicly readable but only writable by admins.
     * @path /products/{productId}
     * @allow (get, list) if true (publicly readable).
     * @allow (create, update, delete) if the user is an admin.
     * @deny (create, update, delete) if the user is not an admin.
     * @principle Public read, admin-only writes.
     */
    match /products/{productId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Controls access to orders placed by users. Users can only read/write their own orders. Admins can read and write all orders.
     * @path /users/{userId}/orders/{orderId}
     * @allow (create, update, get, delete) if the user's UID matches the userId or if the user is an admin.
     * @deny (create, update, get, delete) if the user's UID does not match the userId and the user is not an admin.
     * @principle Enforces document ownership for writes and reads.
     */
    match /users/{userId}/orders/{orderId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    /**
     * @description Controls access to cart items for each user. Users can only read/write their own cart items.
     * @path /users/{userId}/cart_items/{cartItemId}
     * @allow (create, update, get, delete) if the user's UID matches the userId.
     * @deny (create, update, get, delete) if the user's UID does not match the userId.
     * @principle Enforces document ownership for writes and reads.
     */
    match /users/{userId}/cart_items/{cartItemId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    /**
     * @description Controls access to chat messages. Access is based on senderId and receiverId.
     * @path /chat_messages/{chatMessageId}
     * @allow (create, get, list) if the user is either the sender or the receiver.
     * @allow (update, delete) never allowed.
     * @principle Enforces that only participants can read and write messages.
     */
    match /chat_messages/{chatMessageId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to flyer information. Flyers are publicly readable but only writable by admins.
     * @path /flyers/{flyerId}
     * @allow (get, list) if true (publicly readable).
     * @allow (create, update, delete) if the user is an admin.
     * @deny (create, update, delete) if the user is not an admin.
     * @principle Public read, admin-only writes.
     */
    match /flyers/{flyerId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Controls access to service checklist items for custom orders. Accessible by the user and admins.
     * @path /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId}
     * @allow (create, update, get, delete) if the user's UID matches the userId or if the user is an admin.
     * @deny (create, update, get, delete) if the user's UID does not match the userId and the user is not an admin.
     * @principle Enforces document ownership for writes and reads.
     */
    match /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    /**
     * @description Grants admin privileges based on the existence of a document in this collection.
     * @path /roles_admin/{userId}
     * @allow create if the user's UID matches the userId.
     * @allow get, update, delete if the user is an admin.
     * @deny get, update, delete if the user is not an admin.
     * @principle Existence-based admin role.
     */
    match /roles_admin/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Controls access to notifications for individual users.
     * @path /users/{userId}/notifications/{notificationId}
     *  @allow (create, update, get, delete) if the user's UID matches the userId.
     * @deny (create, update, get, delete) if the user's UID does not match the userId.
     * @principle Enforces document ownership for writes and reads.
     */
    match /users/{userId}/notifications/{notificationId} {
       function isSignedIn() {
        return request.auth != null;
      }

       function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    /**
     * @description Controls access to global application settings. Writable only by admins.
     * @path /settings/{settingId}
     * @allow (get, list) if true (publicly readable).
     * @allow (create, update, delete) if the user is an admin.
     * @deny (create, update, delete) if the user is not an admin.
     * @principle Public read, admin-only writes.
     */
    match /settings/{settingId} {
        function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}