/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model, granting full access to users with the 'owner' role.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles.
 * - /products/{productId}: Stores product information.
 * - /users/{userId}/orders/{orderId}: Stores orders placed by users.
 * - /users/{userId}/cart_items/{cartItemId}: Stores cart items for each user.
 * - /chat_messages/{chatMessageId}: Stores chat messages between users and admins.
 * - /flyers/{flyerId}: Stores flyer information.
 * - /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId}: Stores service checklist items for custom orders.
 * - /roles_admin/{userId}: Stores admin role assignments. Existence of a document grants admin privileges.
 * - /users/{userId}/notifications/{notificationId}: Stores notifications for individual users.
 * - /settings/{settingId}: Stores global application settings.
 *
 * Key Security Decisions:
 * - Full access granted to users with 'owner' role via custom token.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profiles.
     * @path /users/{userId}
     * @allow (create, update, get, delete, list) if request.auth.token.role == 'owner';
     * @deny (create) if request.auth == null;
     * @principle Role-based access control for user profiles.
     */
    match /users/{userId} {
      allow get, list, create, update, delete: if request.auth.token.role == 'owner';
    }

    /**
     * @description Manages product information.
     * @path /products/{productId}
     * @allow (create, update, get, delete, list) if request.auth.token.role == 'owner';
     * @deny (create) if request.auth == null;
     * @principle Role-based access control for product data.
     */
    match /products/{productId} {
      allow get, list, create, update, delete: if request.auth.token.role == 'owner';
    }

    /**
     * @description Manages orders placed by users.
     * @path /users/{userId}/orders/{orderId}
     * @allow (create, update, get, delete, list) if request.auth.token.role == 'owner';
     * @deny (create) if request.auth == null;
     * @principle Role-based access control for order management.
     */
    match /users/{userId}/orders/{orderId} {
      allow get, list, create, update, delete: if request.auth.token.role == 'owner';
    }

    /**
     * @description Manages cart items for each user.
     * @path /users/{userId}/cart_items/{cartItemId}
     * @allow (create, update, get, delete, list) if request.auth.token.role == 'owner';
     * @deny (create) if request.auth == null;
     * @principle Role-based access control for shopping cart.
     */
    match /users/{userId}/cart_items/{cartItemId} {
      allow get, list, create, update, delete: if request.auth.token.role == 'owner';
    }

    /**
     * @description Manages chat messages between users and admins.
     * @path /chat_messages/{chatMessageId}
     * @allow (create, update, get, delete, list) if request.auth.token.role == 'owner';
     * @deny (create) if request.auth == null;
     * @principle Role-based access control for chat messages.
     */
    match /chat_messages/{chatMessageId} {
      allow get, list, create, update, delete: if request.auth.token.role == 'owner';
    }

    /**
     * @description Manages flyer information.
     * @path /flyers/{flyerId}
     * @allow (create, update, get, delete, list) if request.auth.token.role == 'owner';
     * @deny (create) if request.auth == null;
     * @principle Role-based access control for promotional flyers.
     */
    match /flyers/{flyerId} {
      allow get, list, create, update, delete: if request.auth.token.role == 'owner';
    }

    /**
     * @description Manages service checklist items for custom orders.
     * @path /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId}
     * @allow (create, update, get, delete, list) if request.auth.token.role == 'owner';
     * @deny (create) if request.auth == null;
     * @principle Role-based access control for service checklists.
     */
    match /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId} {
      allow get, list, create, update, delete: if request.auth.token.role == 'owner';
    }

    /**
     * @description Manages admin role assignments.
     * @path /roles_admin/{userId}
     * @allow (create, update, get, delete, list) if request.auth.token.role == 'owner';
     * @deny (create) if request.auth == null;
     * @principle Role-based access control for admin roles.
     */
    match /roles_admin/{userId} {
      allow get, list, create, update, delete: if request.auth.token.role == 'owner';
    }

    /**
     * @description Manages notifications for individual users.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (create, update, get, delete, list) if request.auth.token.role == 'owner';
     * @deny (create) if request.auth == null;
     * @principle Role-based access control for user notifications.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get, list, create, update, delete: if request.auth.token.role == 'owner';
    }

    /**
     * @description Manages global application settings.
     * @path /settings/{settingId}
     * @allow (create, update, get, delete, list) if request.auth.token.role == 'owner';
     * @deny (create) if request.auth == null;
     * @principle Role-based access control for application settings.
     */
    match /settings/{settingId} {
      allow get, list, create, update, delete: if request.auth.token.role == 'owner';
    }
  }
}