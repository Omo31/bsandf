rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // This rule allows anyone to read and write to the entire database.
    // It will expire on a future date (usually 30 days from project creation).
    // After this date, all requests will be denied.
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2024, 8, 21);
    }
  }
}