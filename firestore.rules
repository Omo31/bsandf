/**
 * @file Firestore Security Rules for BeautifulSoup&Food
 * @version Prototyping
 *
 * @description
 * This ruleset enforces a user-ownership model for user-specific data
 * and allows public read access for products and flyers. Sitewide settings
 * are accessible to all authenticated users, while writes are disallowed for now.
 *
 * @dataStructure
 * - /users/{userId}: Stores user profiles.
 * - /products/{productId}: Stores product information.
 * - /users/{userId}/orders/{orderId}: Stores orders placed by users.
 * - /users/{userId}/cart_items/{cartItemId}: Stores cart items for each user.
 * - /flyers/{flyerId}: Stores flyer information.
 * - /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId}: Stores service checklist items for custom orders.
 * - /users/{userId}/notifications/{notificationId}: Stores notifications for individual users.
 * - /settings/{settingId}: Stores global application settings.
 *
 * @keySecurityDecisions
 * - User data is strictly controlled by the owning user.
 * - Products and flyers are publicly readable but writes are disabled for now.
 * - Listing of user subcollections is allowed only by the owning user.
 * - Global settings are publicly readable, writes are disallowed for now.
 * - In this prototyping phase, data validation is relaxed to allow for rapid iteration.
 *   Only authorization-critical fields are validated.
 *
 * @denormalizationForAuthorization
 *   N/A - No denormalization is used in this initial rules set. More advanced
 *   authorization patterns may require denormalization in the future.
 *
 * @structuralSegregation
 *   User-specific data is stored in subcollections under `/users/{userId}` to
 *   ensure private access and efficient path-based authorization. Public
 *   data (products, flyers) is stored in top-level collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) User with uid "user123" can create their own profile.
     * @allow (get,update,delete) User with uid "user123" can get, update, and delete their own profile.
     * @deny (create) User with uid "user456" cannot create a profile for "user123".
     * @deny (get,update,delete) User with uid "user456" cannot get, update, or delete "user123"'s profile.
     * @principle Enforces document ownership for writes; allows owner-only reads.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      // Allow the user to read its own document.
      allow get: if isOwner(userId);
      // Allow the user to list all user document (disabled for privacy).
      allow list: if false;
      // Allow the user to create its own document, validating the userId.
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      // Allow the user to update its own document.
      allow update: if isOwner(userId) && resource.data.uid == userId;
      // Allow the user to delete its own document.
      allow delete: if isOwner(userId) && resource.data.uid == userId;
    }

    /**
     * @description Controls access to product documents. Public read, no writes allowed.
     * @path /products/{productId}
     * @allow (get, list) Any user can read product information.
     * @deny (create, update, delete) No user can create, update, or delete product information.
     * @principle Allows public read access; restricts write access.
     */
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to order documents under a specific user.
     * @path /users/{userId}/orders/{orderId}
     * @allow (create) User with uid "user123" can create an order under their ID.
     * @allow (get, list, update, delete) User with uid "user123" can read, list, update, and delete orders under their ID.
     * @deny (create) User with uid "user456" cannot create an order for "user123".
     * @deny (get, list, update, delete) User with uid "user456" cannot read, list, update, or delete "user123"'s orders.
     * @principle Enforces document ownership for writes; allows owner-only reads.
     */
    match /users/{userId}/orders/{orderId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isOwner(userId) && resource.data.userId == userId;
      allow delete: if isOwner(userId) && resource.data.userId == userId;
    }

    /**
     * @description Controls access to cart items under a specific user.
     * @path /users/{userId}/cart_items/{cartItemId}
     * @allow (create) User with uid "user123" can create a cart item under their ID.
     * @allow (get, list, update, delete) User with uid "user123" can read, list, update, and delete cart items under their ID.
     * @deny (create) User with uid "user456" cannot create a cart item for "user123".
     * @deny (get, list, update, delete) User with uid "user456" cannot read, list, update, or delete "user123"'s cart items.
     * @principle Enforces document ownership for writes; allows owner-only reads.
     */
    match /users/{userId}/cart_items/{cartItemId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isOwner(userId) && resource.data.userId == userId;
      allow delete: if isOwner(userId) && resource.data.userId == userId;
    }

    /**
     * @description Controls access to flyer documents. Public read, no writes allowed.
     * @path /flyers/{flyerId}
     * @allow (get, list) Any user can read flyer information.
     * @deny (create, update, delete) No user can create, update, or delete flyer information.
     * @principle Allows public read access; restricts write access.
     */
    match /flyers/{flyerId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to service checklist items under a specific order and user.
     * @path /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId}
     * @allow (create) User with uid "user123" can create a checklist item under their order.
     * @allow (get, list, update, delete) User with uid "user123" can read, list, update, and delete checklist items under their order.
     * @deny (create) User with uid "user456" cannot create a checklist item for "user123".
     * @deny (get, list, update, delete) User with uid "user456" cannot read, list, update, or delete "user123"'s checklist items.
     * @principle Enforces document ownership for writes; allows owner-only reads.
     */
    match /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId); // CRITICAL: In prototyping mode, validation of orderId is skipped
      allow update: if isOwner(userId); // CRITICAL: In prototyping mode, validation of orderId is skipped
      allow delete: if isOwner(userId); // CRITICAL: In prototyping mode, validation of orderId is skipped
    }

    /**
     * @description Controls access to notification documents under a specific user.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (create) User with uid "user123" can create a notification under their ID.
     * @allow (get, list, update, delete) User with uid "user123" can read, list, update, and delete notifications under their ID.
     * @deny (create) User with uid "user456" cannot create a notification for "user123".
     * @deny (get, list, update, delete) User with uid "user456" cannot read, list, update, or delete "user123"'s notifications.
     * @principle Enforces document ownership for writes; allows owner-only reads.
     */
    match /users/{userId}/notifications/{notificationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isOwner(userId) && resource.data.userId == userId;
      allow delete: if isOwner(userId) && resource.data.userId == userId;
    }

    /**
     * @description Controls access to global settings documents. Public read, no writes allowed.
     * @path /settings/{settingId}
     * @allow (get, list) Any authenticated user can read settings.
     * @deny (create, update, delete) No user can create, update, or delete settings.
     * @principle Allows public read access; restricts write access.
     */
    match /settings/{settingId} {
        function isSignedIn() {
            return request.auth != null;
        }
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }
  }
}