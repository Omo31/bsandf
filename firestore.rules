/**
 * @file Firestore Security Rules for BeautifulSoup&Food
 * @core_philosophy This ruleset enforces a strict user-ownership model for user-specific data while allowing public read access to product and flyer information.  Admin roles are managed via a dedicated collection.
 * @data_structure User-specific data is nested under /users/{userId}. Public data resides in top-level collections like /products and /flyers.  Admin roles are stored in the `/roles_admin/{uid}` collection.
 * @key_security_decisions Listing of users is explicitly disallowed.  Write access to products and flyers is restricted to admins. Default security posture is deny all unless explicitly allowed.
 * @denormalization Admin role status is checked via existence of a document in `/roles_admin/{uid}`.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) Authenticated user can create their own profile.
     * @allow (get, update, delete) Authenticated user can access and modify their own profile.
     * @deny (create) Non-authenticated user cannot create a profile.
     * @deny (get, update, delete) Authenticated user cannot access or modify another user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing users is not permitted.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for products.
     * @path /products/{productId}
     * @allow (get, list) Anyone can read product information.
     * @allow (create, update, delete) Only admins can create, update, or delete products.
     * @deny (create, update, delete) Non-admins cannot create, update, or delete products.
     * @principle Public read access with admin-only writes.
     */
    match /products/{productId} {
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for orders placed by users.
     * @path /users/{userId}/orders/{orderId}
     * @allow (create) Authenticated user can create their own order.
     * @allow (get, update, delete, list) Authenticated user can access and modify their own orders.
     * @deny (create) Non-authenticated user cannot create an order.
     * @deny (get, update, delete) Authenticated user cannot access or modify another user's order.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/orders/{orderId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
     function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for cart items for each user.
     * @path /users/{userId}/cart_items/{cartItemId}
     * @allow (create) Authenticated user can create cart items.
     * @allow (get, update, delete, list) Authenticated user can access and modify their own cart items.
     * @deny (create) Non-authenticated user cannot create cart items.
     * @deny (get, update, delete) Authenticated user cannot access or modify another user's cart items.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/cart_items/{cartItemId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
     function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for chat messages between users and admins.
     * @path /chat_messages/{chatMessageId}
     * @allow (create) Authenticated user can create chat messages.
     * @allow (get, list) Only the sender or receiver can read the message.
     * @allow (update, delete) Not allowed.
     * @principle Shared access based on sender and receiver IDs.
     */
    match /chat_messages/{chatMessageId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow list: if isSignedIn(); //In prototyping mode, allow listing all messages as a temporary measure for developers.
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for flyers.
     * @path /flyers/{flyerId}
     * @allow (get, list) Anyone can read flyer information.
     * @allow (create, update, delete) Only admins can create, update, or delete flyers.
     * @deny (create, update, delete) Non-admins cannot create, update, or delete flyers.
     * @principle Public read access with admin-only writes.
     */
    match /flyers/{flyerId} {
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for service checklist items for custom orders.
     * @path /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId}
     * @allow (create) Authenticated user can create service checklist items.
     * @allow (get, update, delete, list) Authenticated user can access and modify their own service checklist items.
     * @deny (create) Non-authenticated user cannot create service checklist items.
     * @deny (get, update, delete) Authenticated user cannot access or modify another user's service checklist items.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/orders/{orderId}/service_checklist_items/{serviceChecklistItemId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
     function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for admin role assignments.
     * @path /roles_admin/{userId}
     * @allow (create) Only admins can assign admin roles (This needs to be bootstrapped or handled via Cloud Functions).
     * @allow (get) Anyone can check if a user is an admin.
     * @allow (update, delete, list) Not allowed via rules.
     * @principle Existence check for admin privileges.
     */
    match /roles_admin/{userId} {
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get: if true; // Public read to check admin status.
      allow list: if false;
      allow create: if isAdmin(); // Requires bootstrapping or Cloud Functions.
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for notifications for individual users.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (create) Authenticated user can create a notification for themselves.
     * @allow (get, update, delete, list) Authenticated user can access and modify their own notifications.
     * @deny (create) Non-authenticated user cannot create notifications.
     * @deny (get, update, delete) Authenticated user cannot access or modify another user's notifications.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/notifications/{notificationId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
     function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for global application settings.
     * @path /settings/{settingId}
     * @allow (get, list) Anyone can read settings.
     * @allow (create, update, delete) Only admins can modify settings.
     * @deny (create, update, delete) Non-admins cannot modify settings.
     * @principle Public read, admin-only write.
     */
    match /settings/{settingId} {
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }
  }
}